{
  "name": "adb-assistant",
  "version": "1.0.1",
  "description": "ADB 桌面助手 - 现代化 Android 设备管理工具",
  "main": "dist-electron/electron/main.js",
  "author": "xiaoyang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5273 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:bin": "node scripts/prepare-bin.mjs",
    "check:modules": "python scripts/check-modules.py",
    "test:smoke": "electron scripts/smoke.cjs",
    "test:e2e": "electron scripts/e2e.cjs",
    "test:e2e:record": "electron scripts/e2e-record.cjs",
    "test:packaged": "node scripts/e2e-packaged.cjs",
    "test:packaged:features": "node scripts/e2e-packaged-features.cjs",
    "inspect:asar": "python scripts/inspect-asar.py",
    "inspect:pe": "python scripts/pe-version.py",
    "build:mirror": "python scripts/prepare-eb-mirror.py",
    "build:safe": "python scripts/build.py",
    "capture:ui": "electron scripts/capture-ui.cjs",
    "test:installed": "node scripts/e2e-installed.cjs",
    "test:mirror:installed": "node scripts/e2e-mirror-installed.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "rollup": "^4.30.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.2"
  }
}
