# 依赖
node_modules/

# 构建产物
dist/
dist-electron/
release/
bin/

# Android / Gradle 构建产物
# ⚠️ 模块目录会新增（app / probe / recorder …），这里用通配兜住，
#    否则每次加模块都要补一条，漏了就会把 ~30 MB 的 build/ 提交上去。
android/.gradle/
android/**/.gradle/
android/build/
android/**/build/
android/local.properties
android/**/local.properties
*.apk
*.aab

# 打包产物
dist-release/
dist-release-broken-*/
dist-release.broken-*/
dist-pkg/

# 中间产物 / 试验输出
out-*/
build-output/
eb-mirror/
ui-shots/
e2e-tmp/

# 日志与调试产物
